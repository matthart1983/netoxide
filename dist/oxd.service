# systemd unit for the Netoxide daemon.
#
# Install: copy to /etc/systemd/system/oxd.service, put the binaries in
# /usr/bin, then `systemctl enable --now oxd`.
#
# tests/vm/run.sh installs this unit in a virtual machine and checks the
# daemon under it: DNS, DHCP, traffic, a crash, a reboot. It has not run on
# hardware, or on a system with SELinux or AppArmor enforcing.

[Unit]
Description=Netoxide firewall daemon
Documentation=https://github.com/matthart1983/netoxide
# Rules should be in place before interfaces come up.
Wants=network-pre.target
Before=network-pre.target
After=local-fs.target

[Service]
# The daemon says when the rules are loaded, so the network waits for them.
Type=notify
NotifyAccess=main
# Extra options go in OXD_ARGS, for example:
#   OXD_ARGS=--lockdown --listen 0.0.0.0:8443
# --lockdown drops inbound traffic until the first commit, which cuts a
# remote session. Add it once you can reach the box's console.
EnvironmentFile=-/etc/netoxide/oxd.env
ExecStart=/usr/bin/oxd --state-dir /var/lib/netoxide --socket /run/netoxide/oxd.sock $OXD_ARGS
Restart=on-failure
RestartSec=2

# The daemon's own files. systemd creates these with the right owner.
StateDirectory=netoxide
StateDirectoryMode=0700
RuntimeDirectory=netoxide
RuntimeDirectoryMode=0750

# What it needs: load firewall rules, bind low ports for DNS and DHCP, send
# DHCP replies, let dnsmasq switch to its own user, and stop dnsmasq again
# once it runs as that user (CAP_KILL).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_KILL
AmbientCapabilities=
NoNewPrivileges=yes

# Everything else is closed off.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Not ProtectKernelTunables: the daemon turns on packet forwarding in /proc/sys.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=setuid setgid setgroups capset
UMask=0077

[Install]
WantedBy=multi-user.target
